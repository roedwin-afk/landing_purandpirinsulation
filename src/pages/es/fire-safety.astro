---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLang, useTranslations } from "../../i18n/utils";
import {
  ShieldCheck,
  BadgeCheck,
  FlameKindling,
  Info
} from "lucide-astro";
import { Image } from "astro:assets";
import pirVsPurImg from "../../assets/images/pir-vs-pur-carbonizacion.png";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);
const tp = t.pages.fireSafety;
const prefix = lang === "es" ? `${base}es/` : base;
---

<BaseLayout t={t} lang={lang} canonicalUrl={Astro.url.href}>
  <main>
    <!-- Hero -->
    <div class="fs-hero">
      <div class="container fs-hero__inner">
        <div class="fs-hero__content">
          <div class="fs-hero__eyebrow">
            <ShieldCheck size={14} />
            {tp.hero.eyebrow}
          </div>
          <h1 class="fs-hero__title">
            {tp.hero.title}
            <span class="fs-hero__accent">{tp.hero.titleAccent}</span>
          </h1>
          <p class="fs-hero__desc">{tp.hero.description}</p>
        </div>

        <div class="fs-hero__visual" aria-hidden="true">
          <div class="fs-hero__badge-group">
            <div class="fs-hero__badge fs-hero__badge--a1">
              <span class="fs-hero__badge-class">A1</span>
              <span class="fs-hero__badge-label">Lana de roca</span>
            </div>
            <div class="fs-hero__badge fs-hero__badge--b">
              <span class="fs-hero__badge-class">B-s1,d0</span>
              <span class="fs-hero__badge-label">PIR</span>
            </div>
            <div class="fs-hero__badge fs-hero__badge--fm">
              <span class="fs-hero__badge-class">FM 4880</span>
              <span class="fs-hero__badge-label">Certificación</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Euroclass Section -->
    <section class="fs-section">
      <div class="container">
        <h2 class="fs-section__title reveal">{tp.euroclass.title}</h2>
        <p class="fs-section__desc reveal">{tp.euroclass.description}</p>
        <div class="fs-table-wrap reveal">
          <table class="fs-table">
            <thead>
              <tr>
                <th>{tp.euroclass.tableHeaders.class}</th>
                <th>{tp.euroclass.tableHeaders.material}</th>
                <th>{tp.euroclass.tableHeaders.smoke}</th>
                <th>{tp.euroclass.tableHeaders.droplets}</th>
              </tr>
            </thead>
            <tbody>
              {
                tp.euroclass.rows.map((row) => (
                  <tr>
                    <td>
                      <strong>{row.class}</strong>
                    </td>
                    <td>{row.material}</td>
                    <td>{row.smoke}</td>
                    <td>{row.droplets}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="fs-legend reveal">
          {
            tp.euroclass.legend.map((item) => (
              <div class="fs-legend__item">
                <strong>{item.key}</strong> — {item.value}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PIR Carbonization -->
    <section class="fs-section fs-section--alt">
      <div class="container fs-carbonization">
        <div class="fs-carbonization__text reveal">
          <div class="fs-carbonization__eyebrow">
            <FlameKindling size={16} />
            {tp.carbonization.eyebrow}
          </div>
          <h2 class="fs-carbonization__title">{tp.carbonization.title}</h2>
          <p>{tp.carbonization.description}</p>
          <ul class="fs-carbonization__list">
            {
              tp.carbonization.benefits.map((benefit) => (
                <li>
                  <ShieldCheck size={16} />
                  {benefit}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="fs-carbonization__visual reveal">
          <Image
            src={pirVsPurImg}
            alt="PIR forms a protective char layer while PUR melts under fire exposure"
            width={600}
            height={300}
            loading="lazy"
            class="fs-diagram-img"
          />
        </div>
      </div>
    </section>

    <!-- FM Global -->
    <section class="fs-section">
      <div class="container">
        <div class="fs-fm reveal">
          <div class="fs-fm__badge">
            <BadgeCheck size={32} />
            {tp.fm.badge}
          </div>
          <div class="fs-fm__content">
            <h2 class="fs-fm__title">{tp.fm.title}</h2>
            <p class="fs-fm__desc">{tp.fm.description}</p>
            <ul class="fs-fm__list">
              {
                tp.fm.tests.map((test) => (
                  <li>
                    <Info size={14} /> {test}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="fs-cta">
      <div class="container fs-cta__inner">
        <h2 class="fs-cta__title">{tp.cta.title}</h2>
        <p class="fs-cta__desc">{tp.cta.description}</p>
        <a href={`${prefix}contact`} class="fs-cta__btn">{tp.cta.btn}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ── Hero ── */
  .fs-hero {
    background: linear-gradient(
      135deg,
      var(--color-hero-bg-start) 0%,
      var(--color-hero-bg-end) 100%
    );
    color: white;
    padding-block: var(--space-16);
    position: relative;
    overflow: hidden;
  }
  .fs-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }
  .fs-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  @media (min-width: 1024px) {
    .fs-hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .fs-hero__content {
    max-width: 42rem;
  }
  .fs-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #60a5fa;
    margin-bottom: var(--space-4);
  }
  .fs-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }
  .fs-hero__accent {
    color: #60a5fa;
  }
  .fs-hero__desc {
    font-size: var(--font-size-lg);
    color: #94a3b8;
    line-height: 1.7;
  }
  .fs-hero__visual {
    flex-shrink: 0;
  }
  .fs-hero__badge-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .fs-hero__badge {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.07);
    backdrop-filter: blur(8px);
    min-width: 200px;
  }
  .fs-hero__badge-class {
    font-size: var(--font-size-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .fs-hero__badge-label {
    font-size: var(--font-size-sm);
    color: #94a3b8;
    font-weight: 500;
  }
  .fs-hero__badge--a1 .fs-hero__badge-class {
    color: #4ade80;
  }
  .fs-hero__badge--b .fs-hero__badge-class {
    color: #60a5fa;
  }
  .fs-hero__badge--fm .fs-hero__badge-class {
    color: #fbbf24;
  }

  /* ── Sections ── */
  .fs-section {
    padding-block: var(--space-20);
    background-color: var(--color-bg);
  }
  .fs-section--alt {
    background-color: var(--color-surface-alt);
  }
  .fs-section__title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .fs-section__desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 48rem;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }
  .fs-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .fs-table {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--color-surface);
    font-size: var(--font-size-sm);
  }
  .fs-table thead tr {
    background-color: var(--color-text);
    color: white;
  }
  .fs-table th {
    padding: var(--space-4);
    text-align: left;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .fs-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .fs-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
  .fs-legend__item strong {
    color: var(--color-text);
  }

  /* ── Carbonization ── */
  .fs-carbonization {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fs-carbonization {
      grid-template-columns: 1fr 1fr;
    }
  }
  .fs-carbonization__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }
  .fs-carbonization__title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .fs-carbonization__list {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .fs-carbonization__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
  .fs-carbonization__list li :global(svg) {
    color: var(--color-success);
    flex-shrink: 0;
  }
  .fs-carbonization__visual {
    display: flex;
    justify-content: center;
  }
  .fs-diagram {
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-inline: auto;
  }

  /* ── FM Global ── */
  .fs-fm {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-10);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 768px) {
    .fs-fm {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }
  .fs-fm__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-primary-muted);
    color: var(--color-primary);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    font-weight: 700;
    font-size: var(--font-size-sm);
    text-align: center;
    min-width: 8rem;
  }
  .fs-fm__title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .fs-fm__desc {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }
  .fs-fm__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
  .fs-fm__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .fs-fm__list li :global(svg) {
    color: #f59e0b;
    flex-shrink: 0;
  }

  /* ── CTA ── */
  .fs-cta {
    padding-block: var(--space-20);
    background-color: var(--color-primary);
    color: white;
    text-align: center;
  }
  .fs-cta__inner {
    max-width: 48rem;
    margin-inline: auto;
  }
  .fs-cta__title {
    font-size: var(--font-size-4xl);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }
  .fs-cta__desc {
    font-size: var(--font-size-lg);
    color: #bfdbfe;
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }
  .fs-cta__btn {
    display: inline-block;
    background-color: white;
    color: var(--color-primary);
    font-weight: 700;
    padding: var(--space-4) var(--space-10);
    border-radius: var(--radius-md);
    transition:
      background-color var(--transition-base),
      transform var(--transition-fast);
  }
  .fs-cta__btn:hover {
    background-color: #eff6ff;
    transform: translateY(-1px);
  }

  .fs-diagram-img {
    width: 100%;
    max-width: 520px;
    height: auto;
    margin-inline: auto;
    display: block;
  }
</style>
