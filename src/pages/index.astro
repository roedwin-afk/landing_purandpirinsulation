---
import BaseLayout from '../layouts/BaseLayout.astro';

import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';

import {
  useTranslations,
  getAlternatePath
} from '../i18n/utils';

const lang = 'en';

const t = useTranslations(lang);

const title =
  'PUR & PIR Insulation | Professional Sandwich Panels';

const description =
  'Technical insulation solutions for industrial sandwich panels.';

const alternatePath = getAlternatePath(
  Astro.url,
  Astro.site?.pathname || ''
);
---

<BaseLayout
  t={t}
  lang={lang}
>
  <Navbar
    t={t}
    lang={lang}
  />

  <main>
    <Hero t={t} />
  </main>
</BaseLayout>

<style>
  .hero-preview {
    padding-block: 8rem;

    background:
      linear-gradient(
        135deg,
        #1e293b 0%,
        #0f172a 100%
      );

    color: white;
  }

  .hero-preview__badge {
    display: inline-flex;

    margin-bottom: 1rem;

    padding:
      0.5rem 0.75rem;

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.1);

    font-size: 0.875rem;
  }

  h1 {
    margin:
      0 0 1rem;

    font-size:
      clamp(
        2.5rem,
        8vw,
        5rem
      );

    line-height: 1;

    max-width: 12ch;
  }

  p {
    max-width: 60ch;

    color: #cbd5e1;

    font-size: 1.125rem;
  }
</style>