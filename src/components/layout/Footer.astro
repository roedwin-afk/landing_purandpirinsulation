---
import { Mail, Phone, MapPin } from "lucide-astro";
import NavLinks from "../ui/NavLinks.astro";
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "es" ? `${base}es/` : `${base}`;
const currentYear = new Date().getFullYear();
---

<footer class="footer">

  <!-- Top bar -->
  <div class="footer__topbar">
    <div class="container footer__topbar-inner">
      <div class="footer__contact-items">
        <a href="mailto:info@panelforcoldroom.com" class="footer__contact-item">
          <Mail size={14} />
          info@panelforcoldroom.com
        </a>
        <a href="tel:+525599903546" class="footer__contact-item">
          <Phone size={14} />
          +52 55 9990 3546
        </a>
        <span class="footer__contact-item footer__contact-item--text">
          <MapPin size={14} />
          Polanco, Mexico City
        </span>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="footer__main">
    <div class="container footer__main-inner">

      <!-- Brand -->
      <div class="footer__brand">
        <a href={prefix} class="footer__logo">
          <div class="footer__logo-icon">I</div>
          <span class="footer__logo-text">
            Pur&Pir<span class="footer__logo-accent">Insulation</span>
          </span>
        </a>
        <p class="footer__desc">{t.footer.description}</p>

        <!-- Certifications -->
        <div class="footer__certs">
          <span class="footer__cert">FM 4880</span>
          <span class="footer__cert">EN 13501-1</span>
          <span class="footer__cert">ISO 9001</span>
        </div>
      </div>

      <!-- Core Materials -->
      <div class="footer__col">
        <h5 class="footer__col-title">{t.footer.coreMaterials.title}</h5>
        <ul class="footer__links">
          <li><a href={`${prefix}#comparative`} class="footer__link">{t.footer.coreMaterials.links.pir}</a></li>
          <li><a href={`${prefix}#comparative`} class="footer__link">{t.footer.coreMaterials.links.pur}</a></li>
          <li><a href={`${prefix}#comparative`} class="footer__link">{t.footer.coreMaterials.links.rockwool}</a></li>
          <li><a href={`${prefix}#comparative`} class="footer__link">{t.footer.coreMaterials.links.coldRoom}</a></li>
        </ul>
      </div>

      <!-- Technical Docs -->
      <div class="footer__col">
        <h5 class="footer__col-title">{t.footer.technical.title}</h5>
        <ul class="footer__links">
          <li><a href={`${prefix}#technical`} class="footer__link">{t.footer.technical.links.uvalue}</a></li>
          <li><a href={`${prefix}#fire-safety`} class="footer__link">{t.footer.technical.links.fire}</a></li>
          <li><a href={`${prefix}contact/`} class="footer__link">{t.footer.technical.links.installation}</a></li>
          <li><a href={`${prefix}contact/`} class="footer__link">{t.footer.technical.links.bim}</a></li>
        </ul>
      </div>

      <!-- Navigation -->
      <div class="footer__col">
        <h5 class="footer__col-title">
          {lang === "es" ? "Navegación" : "Navigation"}
        </h5>
        <NavLinks t={t} lang={lang} orientation="vertical" />
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">
        &copy; {currentYear} {t.footer.copyright}
      </p>
      <div class="footer__bottom-links">
        <a href={`${prefix}#`} class="footer__bottom-link">{t.footer.privacy}</a>
        <a href={`${prefix}#`} class="footer__bottom-link">{t.footer.compliance}</a>
        <a href={`${prefix}contact/`} class="footer__bottom-link">{t.footer.contact}</a>
      </div>
    </div>
  </div>

</footer>

<style>
  .footer {
    background-color: var(--color-footer-bg);
    color: var(--color-footer-text);
  }

  /* Top bar */
  .footer__topbar {
    background-color: var(--color-primary);
    padding-block: var(--space-3);
  }

  .footer__topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer__contact-items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: white;
    text-decoration: none;
    transition: opacity var(--transition-base);
  }

  .footer__contact-item:hover {
    opacity: 0.8;
  }

  .footer__contact-item--text {
    cursor: default;
  }

  /* Main */
  .footer__main {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-footer-border);
  }

  .footer__main-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .footer__main-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__main-inner {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  /* Brand */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .footer__logo-icon {
    width: 2rem;
    height: 2rem;
    background-color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: var(--font-size-sm);
  }

  .footer__logo-text {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .footer__logo-accent {
    color: var(--color-primary-light);
  }

  .footer__desc {
    font-size: var(--font-size-sm);
    line-height: 1.7;
    color: var(--color-footer-text);
    max-width: 22rem;
    margin-bottom: var(--space-5);
  }

  .footer__certs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__cert {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-radius: var(--radius-full);
    padding: 0.2rem 0.65rem;
    letter-spacing: 0.05em;
  }

  /* Columns */
  .footer__col-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
    margin-bottom: var(--space-4);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    font-size: var(--font-size-sm);
    color: var(--color-footer-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__link:hover {
    color: var(--color-primary-light);
  }

  /* Bottom */
  .footer__bottom {
    padding-block: var(--space-6);
  }

  .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer__bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer__copyright {
    font-size: var(--font-size-xs);
    color: #475569;
  }

  .footer__bottom-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer__bottom-link {
    font-size: var(--font-size-xs);
    color: #475569;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__bottom-link:hover {
    color: white;
  }
</style>