---
import NavLinks from "../ui/NavLinks.astro";
import MobileMenu from "./MobileMenu.astro";
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import { Image } from "astro:assets";

import logo from "../../assets/logo.svg";

interface Props {
    t: TranslationKeys;
    lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const alternateLang = lang === "en" ? "es" : "en";
const prefix = lang === "es" ? `${base}es/` : `${base}`;

const currentPath = Astro.url.pathname.replace(base, "").replace(/^es\//, "");
const alternatePath =
    lang === "en" ? `${base}es/${currentPath}` : `${base}${currentPath}`;
---

<header class="navbar">
    <div class="container navbar__inner">
        <!-- Logo -->
        <a href={prefix} class="navbar__logo">
            <Image
                src={logo}
                alt="Panel sándwich para techo industrial"
                width={200}
                height={70}
                class="navbar__logo-img"
                format="webp"
                quality={95}
                loading="eager"
                format="svg"
            />
        </a>

        <!-- Desktop Nav -->
        <nav class="navbar__nav" aria-label="Main navigation">
            <NavLinks t={t} lang={lang} orientation="horizontal" />
        </nav>

        <!-- Right side -->
        <div class="navbar__actions">
            <!-- Language switcher -->
            <a
                href={alternatePath}
                class="navbar__lang-switch"
                aria-label="Switch language"
            >
                <span class="navbar__lang-badge"
                    >{alternateLang.toUpperCase()}</span
                >
            </a>

            <!-- CTA -->
            <a href={`${prefix}contact`} class="navbar__cta">
                {t.nav.getQuote}
            </a>

            <!-- Hamburger -->
            <button
                class="navbar__hamburger"
                id="menu-toggle"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <span class="navbar__hamburger-line"></span>
                <span class="navbar__hamburger-line"></span>
                <span class="navbar__hamburger-line"></span>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu -->
<MobileMenu t={t} lang={lang} />

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: rgb(255 255 255 / 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        height: var(--navbar-height);
    }

    .navbar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
        /* gap: var(--space-4); */
    }

    /* Logo */
    .navbar__logo {
        font-size: var(--text-xl);
        font-weight: 800;
        color: var(--color-primary);
    }

    /* Desktop nav */
    .navbar__nav {
        display: none;
        flex: 1;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .navbar__nav {
            display: flex;
        }
    }

    /* Actions */
    .navbar__actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-shrink: 0;
    }

    /* Language switcher */
    .navbar__lang-switch {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .navbar__lang-badge {
        font-size: var(--font-size-xs);
        font-weight: 700;
        color: var(--color-text-light);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        padding: 0.2rem 0.55rem;
        letter-spacing: 0.05em;
        transition:
            color var(--transition-base),
            border-color var(--transition-base);
    }

    .navbar__lang-switch:hover .navbar__lang-badge {
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    /* CTA button */
    .navbar__cta {
        display: none;
        background-color: var(--color-primary);
        color: white;
        padding: 0.625rem 1.25rem;
        border-radius: var(--radius-md);
        font-size: var(--font-size-sm);
        font-weight: 600;
        text-decoration: none;
        transition: background-color var(--transition-base);
        box-shadow: var(--shadow-primary);
        white-space: nowrap;
    }

    .navbar__cta:hover {
        background-color: var(--color-primary-dark);
    }

    @media (min-width: 768px) {
        .navbar__cta {
            display: block;
        }
    }

    /* Hamburger */
    .navbar__hamburger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 2.25rem;
        height: 2.25rem;
        padding: var(--space-2);
        border-radius: var(--radius-md);
        background: none;
        border: none;
        cursor: pointer;
        transition: background-color var(--transition-base);
    }

    .navbar__hamburger:hover {
        background-color: var(--color-surface-alt);
    }

    .navbar__hamburger-line {
        display: block;
        width: 100%;
        height: 2px;
        background-color: var(--color-text);
        border-radius: var(--radius-full);
        transition:
            transform var(--transition-base),
            opacity var(--transition-base);
    }

    @media (min-width: 768px) {
        .navbar__hamburger {
            display: none;
        }
    }
</style>
