---
import { Menu, X } from 'lucide-astro';

import NavLinks from '../ui/NavLinks.astro';

import type { TranslationKeys } from '../../i18n/en';

interface Props {
  t: TranslationKeys;
  lang: 'en' | 'es';
}

const { t, lang } = Astro.props;

const base = lang === 'es' ? '/es' : '';
---

<div class="mobile-menu">
  <button
    class="mobile-menu__toggle"
    aria-label="Toggle Menu"
  >
    <Menu class="menu-icon menu-open" />

    <X class="menu-icon menu-close" />
  </button>

  <div class="mobile-menu__panel">
    <NavLinks
      t={t}
      lang={lang}
      variant="mobile"
    />

    <a
      href={`${base}/#quote`}
      class="mobile-menu__cta"
    >
      {t.nav.getQuote}
    </a>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const menu = document.querySelector('.mobile-menu');

    if (!menu) return;

    const toggle = menu.querySelector(
      '.mobile-menu__toggle'
    );

    const panel = menu.querySelector(
      '.mobile-menu__panel'
    );

    toggle?.addEventListener('click', () => {
      menu.classList.toggle('is-open');

      document.body.classList.toggle(
        'menu-open'
      );
    });

    panel
      ?.querySelectorAll('a')
      .forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('is-open');

          document.body.classList.remove(
            'menu-open'
          );
        });
      });
  });
</script>

<style>
  .mobile-menu {
    display: block;
  }

  .mobile-menu__toggle {
    width: 3rem;
    height: 3rem;

    display: grid;
    place-items: center;

    border: none;
    background: transparent;

    cursor: pointer;

    color: var(--color-text);
  }

  .menu-icon {
    position: absolute;

    transition:
      opacity var(--transition),
      transform var(--transition);
  }

  .menu-close {
    opacity: 0;
    transform: rotate(90deg);
  }

  .mobile-menu.is-open .menu-open {
    opacity: 0;
    transform: rotate(90deg);
  }

  .mobile-menu.is-open .menu-close {
    opacity: 1;
    transform: rotate(0);
  }

  .mobile-menu__panel {
    position: fixed;

    inset: 5rem 0 0;

    background: rgba(255, 255, 255, 0.98);

    backdrop-filter: blur(16px);

    padding: 2rem;

    display: flex;
    flex-direction: column;
    gap: 2rem;

    transform: translateX(100%);
    transition: transform var(--transition);

    z-index: 999;
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;

    min-height: 3rem;

    padding-inline: 1.5rem;

    border-radius: var(--radius-md);

    background: var(--color-primary);

    color: var(--color-white);

    font-weight: 600;

    transition:
      background var(--transition);
  }

  .mobile-menu__cta:hover {
    background: var(--color-primary-dark);
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (width >= 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>