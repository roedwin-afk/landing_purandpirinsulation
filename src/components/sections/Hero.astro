---
import type { TranslationKeys } from '../../i18n/en';

interface Props {
  t: TranslationKeys;
}

const { t } = Astro.props;
---

<section class="hero">
  <!-- Background Grid -->
  <div class="hero__grid"></div>

  <div class="container hero__container">
    <div class="hero__content">
      <span class="hero__badge">
        {t.hero.badge}
      </span>

      <h1 class="hero__title">
        {t.hero.title}

        <span>
          {t.hero.highlight}
        </span>
      </h1>

      <p class="hero__description">
        {t.hero.description}
      </p>

      <div class="hero__actions">
        <a
          href="#quote"
          class="hero__button hero__button--primary"
        >
          {t.hero.primaryButton}
        </a>

        <a
          href="#technical"
          class="hero__button hero__button--secondary"
        >
          {t.hero.secondaryButton}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

    overflow: hidden;

    background:
      linear-gradient(
        135deg,
        #1e293b 0%,
        #0f172a 100%
      );

    color: white;

    isolation: isolate;
  }

  .hero__container {
    position: relative;
    z-index: 2;

    min-height: calc(100vh - 5rem);

    display: flex;
    align-items: center;

    padding-block:
      clamp(5rem, 10vw, 8rem);
  }

  .hero__content {
    max-width: 48rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;

    margin-bottom: 1.5rem;

    padding:
      0.65rem 1rem;

    border:
      1px solid rgba(255, 255, 255, 0.1);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.06);

    backdrop-filter: blur(12px);

    color: #cbd5e1;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .hero__title {
    margin: 0 0 1.5rem;

    font-size:
      clamp(
        3rem,
        8vw,
        6rem
      );

    line-height: 0.95;

    letter-spacing: -0.04em;

    max-width: 12ch;
  }

  .hero__title span {
    display: block;

    color: #60a5fa;
  }

  .hero__description {
    max-width: 60ch;

    margin: 0 0 2.5rem;

    color: #cbd5e1;

    font-size:
      clamp(
        1rem,
        2vw,
        1.2rem
      );

    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 3.5rem;

    padding-inline: 1.75rem;

    border-radius: var(--radius-md);

    font-weight: 600;

    transition:
      transform var(--transition),
      background var(--transition),
      border-color var(--transition);
  }

  .hero__button:hover {
    transform: translateY(-2px);
  }

  .hero__button--primary {
    background: white;

    color: var(--color-text);
  }

  .hero__button--primary:hover {
    background: #e2e8f0;
  }

  .hero__button--secondary {
    border:
      1px solid rgba(255, 255, 255, 0.2);

    background:
      rgba(255, 255, 255, 0.05);

    backdrop-filter: blur(12px);

    color: white;
  }

  .hero__button--secondary:hover {
    background:
      rgba(255, 255, 255, 0.1);
  }

  .hero__grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.04)
          1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04)
          1px,
        transparent 1px
      );

    background-size:
      4rem 4rem;

    mask-image:
      radial-gradient(
        circle at center,
        black,
        transparent 85%
      );

    opacity: 0.6;

    z-index: 1;
  }

  @media (width < 768px) {
    .hero__title {
      max-width: 10ch;
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__button {
      width: 100%;
    }
  }
</style>