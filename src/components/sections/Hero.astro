---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "es" ? `${base}es/` : `${base}`;
---

<section class="hero">
  <!-- Grid pattern background -->
  <div class="hero__pattern" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100" height="100" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">
        {t.hero.title}
        <span class="hero__title-accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero__description">{t.hero.description}</p>
      <div class="hero__actions">
        <a href={`${prefix}#quote`} class="hero__btn hero__btn--primary">
          {t.hero.downloadCatalog}
        </a>
        <a href={`${prefix}#technical`} class="hero__btn hero__btn--secondary">
          {t.hero.viewStandards}
        </a>
      </div>
    </div>

    <!-- Floating stats -->
    <div class="hero__stats" aria-hidden="true">
      <div class="hero__stat">
        <span class="hero__stat-value">0.020</span>
        <span class="hero__stat-label">W/m·K (PIR)</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-value">B-s1</span>
        <span class="hero__stat-label">Fire Class</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-value">A1</span>
        <span class="hero__stat-label">Mineral Wool</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--color-hero-bg-start) 0%, var(--color-hero-bg-end) 100%);
    color: white;
    padding-block: var(--space-24);
    overflow: hidden;
  }

  /* Grid pattern */
  .hero__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    pointer-events: none;
  }

  .hero__pattern svg {
    width: 100%;
    height: 100%;
  }

  /* Inner layout */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Content */
  .hero__content {
    max-width: 42rem;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero__title-accent {
    display: block;
    color: var(--color-primary-light);
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .hero__btn--primary {
    background-color: white;
    color: var(--color-text);
  }

  .hero__btn--primary:hover {
    background-color: #f1f5f9;
  }

  .hero__btn--secondary {
    background-color: transparent;
    color: white;
    border: 1px solid rgb(255 255 255 / 0.35);
  }

  .hero__btn--secondary:hover {
    background-color: rgb(255 255 255 / 0.1);
  }

  /* Stats */
  .hero__stats {
    display: flex;
    flex-direction: row;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (min-width: 1024px) {
    .hero__stats {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-6);
      flex-shrink: 0;
    }
  }

  .hero__stat {
    background-color: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-6);
    text-align: center;
    backdrop-filter: blur(8px);
    min-width: 7rem;
  }

  .hero__stat-value {
    display: block;
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-primary-light);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero__stat-label {
    display: block;
    font-size: var(--font-size-xs);
    color: #94a3b8;
    margin-top: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>