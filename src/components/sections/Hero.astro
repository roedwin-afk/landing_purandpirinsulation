---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "es" ? `${base}es/` : `${base}`;

const fileName = lang === "es" ? `${base}files/catalogo-tecnico-de-paneles-sandwich.pdf` : `${base}files/technical-catalog-of-sandwich-panels.pdf`;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content hero__animate">
      <h1 class="hero__title">
        {t.hero.title}
        <span class="hero__title-accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero__description">{t.hero.description}</p>
      <div class="hero__actions">
        <a href={fileName} download class="hero__btn hero__btn--primary">
          {t.hero.downloadCatalog}
        </a>
        <a href={`${prefix}#technical`} class="hero__btn hero__btn--secondary">
          {t.hero.viewStandards}
        </a>
      </div>
    </div>

    <div class="hero__stats hero__animate hero__animate--delay" aria-hidden="true">
      <div class="hero__stat">
        <span class="hero__stat-value">0.020</span>
        <span class="hero__stat-label">W/m·K (PIR)</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-value">B-s1</span>
        <span class="hero__stat-label">{lang === "es" ? "Clase de Incendio" : "Fire Class"}</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-value">A1</span>
        <span class="hero__stat-label">{lang === "es" ? "Algodón Mineral" : "Mineral Wool"}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: white;
    padding-block: var(--space-24);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .hero__content {
    max-width: 42rem;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero__title-accent {
    display: block;
    color: #60a5fa;
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }

  .hero__btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: all var(--transition-base);
    text-align: center;
    white-space: nowrap;
  }

  .hero__btn--primary {
    background-color: white;
    color: var(--color-text);
  }

  .hero__btn--primary:hover {
    background-color: #f1f5f9;
  }

  .hero__btn--secondary {
    background-color: transparent;
    color: white;
    border: 1px solid rgb(255 255 255 / 0.35);
  }

  .hero__btn--secondary:hover {
    background-color: rgb(255 255 255 / 0.1);
  }

  /* Stats */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero__stats {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-4);
      width: auto;
      flex-shrink: 0;
    }
  }

  .hero__stat {
    background-color: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-3);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero__stat {
      width: 12rem;
      padding: var(--space-4) var(--space-6);
    }
  }

  .hero__stat-value {
    display: block;
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: #60a5fa;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero__stat-label {
    display: block;
    font-size: var(--font-size-xs);
    color: #94a3b8;
    margin-top: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Animación de entrada */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__animate {
    animation: fadeUp 0.7s ease both;
  }

  .hero__animate--delay {
    animation-delay: 0.2s;
  }
</style>