---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t } = Astro.props;

const rows = [
  {
    label: t.table.rows.conductivity.label,
    pur: t.table.rows.conductivity.pur,
    pir: t.table.rows.conductivity.pir,
    mw: t.table.rows.conductivity.mw,
    highlight: false,
  },
  {
    label: t.table.rows.fire.label,
    pur: t.table.rows.fire.pur,
    pir: t.table.rows.fire.pir,
    mw: t.table.rows.fire.mw,
    highlight: true,
  },
  {
    label: t.table.rows.density.label,
    pur: t.table.rows.density.pur,
    pir: t.table.rows.density.pir,
    mw: t.table.rows.density.mw,
    highlight: false,
  },
  {
    label: t.table.rows.acoustic.label,
    pur: t.table.rows.acoustic.pur,
    pir: t.table.rows.acoustic.pir,
    mw: t.table.rows.acoustic.mw,
    highlight: false,
  },
  {
    label: t.table.rows.applications.label,
    pur: t.table.rows.applications.pur,
    pir: t.table.rows.applications.pir,
    mw: t.table.rows.applications.mw,
    highlight: false,
  },
];
---

<section id="technical" class="table-section">
  <div class="container">
    <h2 class="table-section__title reveal">{t.table.sectionTitle}</h2>

    <!-- Desktop table -->
    <div class="table-wrapper reveal">
      <table class="data-table">
        <thead>
          <tr>
            <th>{t.table.headers.property}</th>
            <th>{t.table.headers.pur}</th>
            <th class="col-pir">{t.table.headers.pir}</th>
            <th>{t.table.headers.mw}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class:list={[{ "row--highlight": row.highlight }]}>
                <td class="cell--label">{row.label}</td>
                <td>{row.pur}</td>
                <td class:list={["col-pir", { "cell--pir": row.highlight }]}>
                  {row.pir}
                </td>
                <td class:list={[{ "cell--mw": row.highlight }]}>{row.mw}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="mobile-cards">
      {
        rows.map((row) => (
          <div class="mobile-card reveal">
            <div class="mobile-card__label">{row.label}</div>
            <div class="mobile-card__values">
              <div class="mobile-card__value">
                <span class="mobile-card__tag mobile-card__tag--pur">PUR</span>
                <span>{row.pur}</span>
              </div>
              <div class="mobile-card__value">
                <span class="mobile-card__tag mobile-card__tag--pir">PIR</span>
                <span class:list={[{ "cell--pir": row.highlight }]}>{row.pir}</span>
              </div>
              <div class="mobile-card__value">
                <span class="mobile-card__tag mobile-card__tag--mw">MW</span>
                <span class:list={[{ "cell--mw": row.highlight }]}>{row.mw}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="table-section__disclaimer reveal">{t.table.disclaimer}</p>
  </div>
</section>

<style>
  .table-section {
    padding-block: var(--space-20);
    background-color: var(--color-surface-alt);
  }

  .table-section__title {
    font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-8);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-primary);
    letter-spacing: -0.02em;
  }

  .table-section__disclaimer {
    margin-top: var(--space-4);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ── Desktop Table ── */
  .table-wrapper {
    overflow-x: auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    display: none;
  }

  @media (min-width: 768px) {
    .table-wrapper {
      display: block;
    }
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .data-table thead tr {
    background-color: var(--color-text);
    color: white;
  }

  /* PIR column header — fondo azul para destacar */
  .data-table thead th.col-pir {
    background-color: var(--color-primary);
    color: white;
  }

  /* PIR column body — fondo azul muy suave */
  .data-table tbody td.col-pir {
    background-color: #eff6ff;
  }

  .data-table th {
    padding: var(--space-4);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .data-table td {
    padding: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover {
    background-color: var(--color-surface-alt);
  }

  .cell--label {
    font-weight: 500;
    color: var(--color-text-light) !important;
    white-space: nowrap;
  }

  .col-pir {
    background-color: #eff6ff;
  }

  .cell--pir {
    color: var(--color-primary) !important;
    font-weight: 600;
  }

  .cell--mw {
    color: var(--color-accent-orange) !important;
    font-weight: 600;
  }

  .row--highlight {
    background-color: #f8fafc;
  }

  /* ── Mobile Cards ── */
  .mobile-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .mobile-cards {
      display: none;
    }
  }

  .mobile-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .mobile-card__label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-card__values {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-card__value {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  .mobile-card__tag {
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }

  .mobile-card__tag--pur {
    background-color: #dbeafe;
    color: var(--color-primary);
  }

  .mobile-card__tag--pir {
    background-color: var(--color-primary);
    color: white;
  }

  .mobile-card__tag--mw {
    background-color: #ffedd5;
    color: var(--color-accent-orange);
  }
</style>