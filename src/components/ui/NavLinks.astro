---
import type { TranslationKeys } from '../../i18n/en';

interface Props {
  t: TranslationKeys;
  lang: 'en' | 'es';
  variant?: 'navbar' | 'mobile' | 'footer';
}

const {
  t,
  lang,
  variant = 'navbar'
} = Astro.props;

const base = lang === 'es' ? '/es' : '';

const links = [
  {
    label: t.nav.technical,
    href: `${base}/#technical`
  },

  {
    label: t.nav.comparative,
    href: `${base}/#comparative`
  },

  {
    label: t.nav.fireSafety,
    href: `${base}/#fire-safety`
  },

  {
    label: t.nav.applications,
    href: `${base}/#applications`
  }
];
---

<nav class={`nav-links nav-links--${variant}`}>
  {
    links.map((link) => (
      <a href={link.href}>
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  .nav-links {
    display: flex;
  }

  .nav-links a {
    transition:
      color var(--transition),
      opacity var(--transition);
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  /* Navbar */

  .nav-links--navbar {
  align-items: center;
  gap: 1.5rem;

  font-size: 0.92rem;
  font-weight: 500;

  color: var(--color-text-light);
}

  /* Mobile */
  .nav-links--mobile {
    flex-direction: column;
    gap: 1.5rem;

    font-size: 1.125rem;
    font-weight: 600;
  }

  /* Footer */
  .nav-links--footer {
    flex-direction: column;
    gap: 1rem;

    font-size: 0.95rem;

    color: #94a3b8;
  }

  .nav-links--footer a:hover {
    color: var(--color-white);
  }
</style>