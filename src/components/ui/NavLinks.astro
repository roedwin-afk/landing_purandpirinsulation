---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
  orientation?: "horizontal" | "vertical";
  currentPath?: string;
  context?: "default" | "footer";
}

const {
  t,
  lang,
  orientation = "horizontal",
  currentPath = "",
  context = "default",
} = Astro.props;
const base = import.meta.env.BASE_URL;

const prefix = lang === "es" ? `${base}es/` : `${base}`;

const links = [
  { href: `${prefix}#comparative`, label: t.nav.comparison },
  { href: `${prefix}fire-safety`, label: t.nav.fireSafety },
  { href: `${prefix}insulation-calculator`, label: t.nav.uvalue },
  { href: `${prefix}blog`, label: t.nav.blog },
];
---

<ul
  class:list={[
    "nav-links",
    `nav-links--${orientation}`,
    `nav-links--${context}`,
  ]}
>
  {
    links.map((link) => {
      const isHashLink = link.href.includes("#");
      const sectionId = isHashLink ? link.href.split("#")[1] : null;

      const normalizedLinkPath = link.href
        .replace(prefix, "")
        .replace(/^\//, "")
        .replace(/\/$/, "");
      const isActive = currentPath === normalizedLinkPath;

      return (
        <li>
          <a
            href={link.href}
            class={`nav-link ${isActive ? "nav-link--active" : ""}`}
            aria-current={isActive ? "page" : undefined}
            data-section={sectionId ?? undefined}
          >
            {link.label}
          </a>
        </li>
      );
    })
  }
</ul>

<script>
  function initSectionObserver() {
    const sectionLinks =
      document.querySelectorAll<HTMLAnchorElement>("a[data-section]");
    if (!sectionLinks.length) return;

    const sectionIds = Array.from(sectionLinks).map((a) => a.dataset.section!);
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          sectionLinks.forEach((a) => {
            a.classList.toggle("nav-link--active", a.dataset.section === id);
          });
        });
      },
      { rootMargin: "-40% 0px -55% 0px", threshold: 0 },
    );

    sections.forEach((s) => observer.observe(s));
  }

  document.addEventListener("astro:page-load", initSectionObserver);
</script>

<style>
  .nav-links {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-links--vertical {
    flex-direction: column;
    gap: 0;
  }

  .nav-links--horizontal {
    flex-direction: row;
    align-items: center;
  }

  .nav-link {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: #e2e8f0;
    text-decoration: none;
    transition: color var(--transition-base);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-links--horizontal .nav-link {
    color: #1f2937;
  }

  .nav-links--horizontal .nav-link:hover {
    color: #0f172a;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link--active {
    font-weight: 700;
  }

  .nav-links--vertical .nav-link {
    display: block;
    font-size: var(--font-size-base);
    padding-block: var(--space-3);
    padding-inline: 0;
    border-radius: var(--radius-md);
    color: var(--color-text);
  }

  .nav-links--vertical .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-links--footer .nav-link {
    color: #e2e8f0;
    font-size: var(--font-size-sm);
  }

  .nav-links--footer .nav-link:hover {
    color: #ffffff;
  }
</style>
