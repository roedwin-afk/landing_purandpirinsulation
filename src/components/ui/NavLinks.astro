---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
  orientation?: "horizontal" | "vertical";
  currentPath?: string;
}

const { t, lang, orientation = "horizontal", currentPath = "" } = Astro.props;
const base = import.meta.env.BASE_URL;

const prefix = lang === "es" ? `${base}es/` : `${base}`;

const links = [
  { href: `${prefix}#comparative`, label: t.nav.comparison },
  { href: `${prefix}fire-safety`, label: t.nav.fireSafety },
  { href: `${prefix}insulation-calculator`, label: t.nav.uvalue },
  { href: `${prefix}blog`, label: t.nav.blog },
];
---

<ul class:list={["nav-links", `nav-links--${orientation}`]}>
  {
    links.map((link) => {
      const normalizedLinkPath = link.href
        .replace(prefix, "")
        .replace(/^\//, "")
        .replace(/\/$/, "");
      const isActive = currentPath === normalizedLinkPath;

      return (
        <li>
          <a
            href={link.href}
            class={`nav-link ${isActive ? "nav-link--active" : ""}`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .nav-links {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-links--vertical {
    flex-direction: column;
    gap: 0;
  }

  .nav-links--horizontal {
    flex-direction: row;
    align-items: center;
  }

  .nav-link {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: #e2e8f0;
    text-decoration: none;
    transition: color var(--transition-base);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-links--horizontal .nav-link {
    color: #1f2937;
  }

  .nav-links--horizontal .nav-link:hover {
    color: #0f172a;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link--active {
    font-weight: 700;
  }

  .nav-links--vertical .nav-link {
    display: block;
    font-size: var(--font-size-base);
    padding-block: var(--space-3);
    padding-inline: 0;
    border-radius: var(--radius-md);
  }

  .nav-links--vertical .nav-link:hover {
    background-color: var(--color-primary-muted);
    color: var(--color-primary);
  }
</style>