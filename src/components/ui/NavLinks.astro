---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
  orientation?: "horizontal" | "vertical";
}

const { t, lang, orientation = "horizontal" } = Astro.props;
const base = import.meta.env.BASE_URL;

const prefix = lang === "es" ? `${base}es/` : `${base}`;

const links = [
  { href: `${prefix}#technical`, label: t.nav.technicalSpecs },
  { href: `${prefix}#comparative`, label: t.nav.comparison },
  { href: `${prefix}#fire-safety`, label: t.nav.fireSafety },
  { href: `${prefix}#applications`, label: t.nav.applications },
];
---

<ul class:list={["nav-links", `nav-links--${orientation}`]}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-links--vertical {
    flex-direction: column;
    gap: 0;
  }

  .nav-links--horizontal {
    flex-direction: row;
    align-items: center;
  }

  .nav-link {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-light);
    text-decoration: none;
    transition: color var(--transition-base);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-links--vertical .nav-link {
    display: block;
    font-size: var(--font-size-base);
    padding-block: var(--space-3);
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
  }

  .nav-links--vertical .nav-link:hover {
    background-color: var(--color-primary-muted);
    color: var(--color-primary);
  }
</style>